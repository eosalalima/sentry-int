@page "/gate"
@rendermode InteractiveServer
@inject SentryIntegrated.Application.Gate.IGateService GateService
<PageTitle>Gate event</PageTitle><div class="monitor-title"><div><span class="eyebrow">INTEGRATED OPERATIONS</span><h1>Gate Event</h1></div></div>
<EditForm Model="model" OnValidSubmit="Submit" class="gate-form"><DataAnnotationsValidator/><ValidationSummary/><label>Access number <InputText @bind-Value="model.AccessNumber"/></label><label>Device ID <InputNumber @bind-Value="model.DeviceId"/></label><label>Verification mode <InputText @bind-Value="model.VerifyMode"/></label><label>Event <InputText @bind-Value="model.EventName"/></label><label>Address <InputText @bind-Value="model.EventAddress"/></label><button disabled="@saving">@(saving ? "Submitting…" : "Create event")</button>@if(message is not null){<p class="form-message">@message</p>}</EditForm>
@code { private FormModel model=new(); private bool saving; private string? message; private async Task Submit(){saving=true;message=null;try{var id=await GateService.InsertAsync(new(model.AccessNumber,model.DeviceId,model.VerifyMode,model.EventName,model.EventAddress,null),CancellationToken.None);message=$"Event {id} created. It will appear after polling.";}catch(SentryIntegrated.Application.Gate.GateValidationException ex){message=ex.Message;}finally{saving=false;}} private sealed class FormModel{[System.ComponentModel.DataAnnotations.Required] public string AccessNumber{get;set;}="";[System.ComponentModel.DataAnnotations.Range(1,int.MaxValue)]public int DeviceId{get;set;}=1;public string VerifyMode{get;set;}="Card";[System.ComponentModel.DataAnnotations.Required]public string EventName{get;set;}="Access granted";public string EventAddress{get;set;}="Gate";} }
